{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/orders/:id/status",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/inventory/adjust",
      "destination": "/api/inventory?action=adjust"
    }
  ]
}
