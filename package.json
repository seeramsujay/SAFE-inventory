{
  "name": "industrial-nexus-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "emulator": "node scripts/worker_emulator.js",
    "cap:sync": "pnpm cap sync",
    "cap:copy": "pnpm cap copy",
    "cap:update": "pnpm cap update",
    "cap:open": "pnpm cap open android",
    "cap:build": "pnpm build && pnpm cap sync",
    "tunnel": "npx localtunnel --port 3001 --host https://localtunnel.me",
    "dev:tunnel": "concurrently \"node server/index.js\" \"vite\" \"npx localtunnel --port 3001 --host https://localtunnel.me\"",
    "prod:tunnel": "concurrently \"node server/index.js\" \"npx localtunnel --port 3001 --host https://localtunnel.me\""
  },
  "dependencies": {
